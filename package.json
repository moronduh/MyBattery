{
  "name": "reflow-preview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5179",
    "build": "vite build",
    "electron:dev": "concurrently \"vite --port 5179\" \"wait-on http://localhost:5179 && NODE_ENV=development electron .\"",
    "electron:build": "ELECTRON=true vite build && electron-builder",
    "deploy:beta": "npm run build && firebase hosting:channel:deploy beta",
    "deploy:live": "npm run build && firebase deploy",
    "promote:beta": "firebase hosting:channel:promote beta live",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.reflow.mybattery",
    "productName": "MyBattery",
    "files": [
      "dist/**/*",
      "electron/**/*.cjs"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/status-bar": "^8.0.2",
    "@ebarooni/capacitor-calendar": "^8.1.0",
    "firebase": "^12.12.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "vite": "^8.0.14",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.10"
  }
}
