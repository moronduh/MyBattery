rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default: deny everything not explicitly matched ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── users (profile, tasks, and all subcollections) ───────────────────────
    // All user data lives under /users/{uid}/…  The uid in the path must match
    // the authenticated caller — no cross-user access possible.
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;

      // Daily mood / energy records
      match /days/{dateKey} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // Journal entries
      match /journal/{entryId} {
        allow read, write, delete: if request.auth != null
                                   && request.auth.uid == uid;
      }

      // Calendar: one document per day, keyed by ISO date string (YYYY-MM-DD)
      match /calendar/{dateKey} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    // ── feedback (write-only; authenticated users only) ──────────────────────
    match /feedback/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

  }
}
